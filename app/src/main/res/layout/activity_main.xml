<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- Forced LTR so the keypad and math aren't mirrored on a Hebrew (RTL) phone -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="ltr"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <TextView
                android:id="@+id/expression"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:autoSizeMaxTextSize="64sp"
                android:autoSizeMinTextSize="26sp"
                android:autoSizeStepGranularity="2sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="start"
                android:fontFamily="sans-serif-light"
                android:gravity="end|bottom"
                android:hint="0"
                android:maxLines="2"
                android:textColor="@color/fg"
                android:textColorHint="@color/fg"
                android:textDirection="ltr" />

            <TextView
                android:id="@+id/result"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:autoSizeMaxTextSize="34sp"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeStepGranularity="2sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-light"
                android:gravity="end|center_vertical"
                android:maxLines="1"
                android:textColor="@color/muted"
                android:textDirection="ltr" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/backspace"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/backspace"
                android:padding="13dp"
                android:src="@drawable/ic_backspace" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="6dp"
            android:background="@color/divider" />

        <LinearLayout
            android:id="@+id/keypad"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.6"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
